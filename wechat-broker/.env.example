WECHAT_BROKER_DATABASE_URL=mysql+aiomysql://wechat_broker_app:CHANGE_ME@127.0.0.1:3306/wechat_broker
WECHAT_BROKER_INTERNAL_API_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS

WECHAT_BROKER_COMPONENT_APPID=wx...
WECHAT_BROKER_COMPONENT_APPSECRET=CHANGE_ME
WECHAT_BROKER_AUTHORIZATION_CALLBACK_URL=https://saas.science.kangqiao.vip/api/wechat-broker/authorization/callback
WECHAT_BROKER_TOKEN_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
WECHAT_BROKER_REQUIRED_FUNCTION_IDS=
WECHAT_BROKER_ALLOWED_RETURN_ORIGINS=https://medicalagent.kangqiao.vip
WECHAT_BROKER_WECHAT_API_TIMEOUT_SECONDS=30

# The existing PHP process is the only ticket writer. This account must be read-only.
WECHAT_BROKER_TICKET_DATABASE_URL=mysql+aiomysql://wechat_ticket_reader:CHANGE_ME@127.0.0.1:3306/saasscience
WECHAT_BROKER_TICKET_DATABASE_TABLE=fa_weixin_component_verify_ticket
# The database is on the same host. Enable verified TLS instead when connecting remotely.
WECHAT_BROKER_TICKET_DATABASE_SSL=false
WECHAT_BROKER_TICKET_DATABASE_SSL_VERIFY=true
