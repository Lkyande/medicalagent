[Unit]
Description=WeChat Open Platform Broker
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/your-platform/wechat-broker
ExecStart=/www/wwwroot/your-platform/wechat-broker/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 18000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
