JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
SANDBOX_WORKSPACE_ROOT=/workspace/users
# OpenCode 沙盒可访问的莫塔医学 MCP 地址，不能填写 localhost 或仅浏览器可访问的相对路径。
# Docker Compose 可使用 backend:8000；远程沙盒开发环境应填写后端的内网/Tailscale IP。
MURTAGH_MCP_URL=http://backend:8000/mcp/murtagh
# OpenCode 沙盒调用莫塔医学 MCP 工具的请求超时，单位毫秒。
MURTAGH_MCP_TIMEOUT_MS=60000
# FastAPI 读取莫塔索引、注册表和审核后 Markdown 正文的目录；Docker 中应挂载为只读。
MURTAGH_KNOWLEDGE_ROOT=/app/knowledge/murtagh

# OpenCode 沙盒可访问的宣教助手 MCP 地址；Docker Compose 可使用 backend:8000。
EDUCATION_MCP_URL=http://backend:8000/mcp/education
# OpenCode 沙盒调用宣教 MCP 工具的空闲超时，单位毫秒；等待工具会通过进度心跳重置该超时。
EDUCATION_MCP_TIMEOUT_MS=120000
# OpenCode 沙盒可访问的平台热点 MCP 地址；该 MCP 再通过 HTTP 调用 Smart Market。
HOT_TOPICS_MCP_URL=http://backend:8000/mcp/hot-topics
# OpenCode 沙盒调用热点 MCP 工具的超时，单位毫秒。
HOT_TOPICS_MCP_TIMEOUT_MS=60000
# 平台后端访问 Smart Market 后端 API 的地址，不是 MCP 地址。
SMART_MARKET_BASE_URL=https://mkt.kangqiao.vip/api/v1
# 平台后端调用 Smart Market API 的 HTTP 超时，单位秒。
SMART_MARKET_TIMEOUT_SECONDS=30
# 可选。Smart Market 启用服务间 API Key 后由平台后端注入，禁止放入 Skill 或工具参数。
SMART_MARKET_API_KEY=
# 平台后端访问独立 wechat_agent 服务的内网地址，不能填写浏览器侧相对路径。
WECHAT_AGENT_BASE_URL=https://wechat-agent.internal:8330
# 单次创建任务或查询状态的 HTTP 超时，单位秒。
WECHAT_AGENT_TIMEOUT_SECONDS=30
# 单次分段等待上限，单位秒；必须明显小于 MCP 超时，未完成时按同一 job_id 续查。
WECHAT_AGENT_PREVIEW_WAIT_SECONDS=60
# 等待工具查询任务状态的间隔，单位秒。
WECHAT_AGENT_PREVIEW_POLL_SECONDS=5
# 传递公众号 access token 的写操作建议使用 HTTPS，并由上游校验 API Key。
WECHAT_AGENT_API_KEY=
WECHAT_AGENT_ALLOW_INSECURE_HTTP=false
# 平台后端代理上传公众号排版图片；该地址不会暴露给浏览器。
IMAGE_UPLOAD_URL=https://saas.aitool.backend.kangqiao.vip/api/common/upload
IMAGE_UPLOAD_FIELD_NAME=file
IMAGE_UPLOAD_TIMEOUT_SECONDS=120
# 微信开放平台第三方平台配置。可由当前平台直接接收 ticket，或从既有 PHP MySQL 只读获取。
WECHAT_COMPONENT_APPID=
WECHAT_COMPONENT_APPSECRET=
WECHAT_COMPONENT_TOKEN=
WECHAT_COMPONENT_ENCODING_AES_KEY=
WECHAT_COMPONENT_AUTHORIZATION_CALLBACK_URL=https://你的平台域名/api/wechat/authorization/callback
# 使用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成。
WECHAT_TOKEN_ENCRYPTION_KEY=
WECHAT_API_TIMEOUT_SECONDS=30
# 可选，逗号分隔的微信开放平台必需授权集 ID；配置后授权缺少任一 ID 都会失败。
WECHAT_REQUIRED_FUNCTION_IDS=
# 复用既有 PHP ticket 时填写。生产必须使用仅能 SELECT ticket 表的专用账号。
WECHAT_TICKET_DATABASE_URL=
WECHAT_TICKET_DATABASE_TABLE=fa_weixin_component_verify_ticket
WECHAT_TICKET_DATABASE_SSL=true
# 公网连接应配置可信 CA 并保持 true；仅临时兼容无可信证书的旧 MySQL 时设为 false。
WECHAT_TICKET_DATABASE_SSL_VERIFY=true

DATABASE_URL=mysql+aiomysql://root:123456@localhost:3320/your_platform
#沙盒相关opencode配置
# Sandbox mapping: SANDBOX_<ID>_URL / SANDBOX_<ID>_PASSWORD
SANDBOX_A_URL=http://10.0.0.11:4096
SANDBOX_A_PASSWORD=change-me
SANDBOX_A_USERNAME=opencode
# Optional per-sandbox override
# SANDBOX_A_WORKSPACE_ROOT=/workspace/users

SANDBOX_B_URL=http://10.0.0.12:4096
SANDBOX_B_PASSWORD=change-me
SANDBOX_B_USERNAME=opencode

CORS_ORIGINS=http://localhost:4444,http://localhost:5173
