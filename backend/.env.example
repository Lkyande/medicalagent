JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
SANDBOX_WORKSPACE_ROOT=/workspace/users
# OpenCode 沙盒可访问的莫塔医学 MCP 地址，不能填写 localhost 或仅浏览器可访问的相对路径。
# Docker Compose 可使用 backend:8000；远程沙盒开发环境应填写后端的内网/Tailscale IP。
MURTAGH_MCP_URL=http://backend:8000/mcp/murtagh
# FastAPI 读取莫塔索引、注册表和审核后 Markdown 正文的目录；Docker 中应挂载为只读。
MURTAGH_KNOWLEDGE_ROOT=/app/knowledge/murtagh

DATABASE_URL=mysql+aiomysql://root:123456@localhost:3320/your_platform
#沙盒相关opencode配置
# Sandbox mapping: SANDBOX_<ID>_URL / SANDBOX_<ID>_PASSWORD
SANDBOX_A_URL=http://10.0.0.11:4096
SANDBOX_A_PASSWORD=change-me
SANDBOX_A_USERNAME=opencode
# Optional per-sandbox override
# SANDBOX_A_WORKSPACE_ROOT=/workspace/users

SANDBOX_B_URL=http://10.0.0.12:4096
SANDBOX_B_PASSWORD=change-me
SANDBOX_B_USERNAME=opencode

CORS_ORIGINS=http://localhost:4444,http://localhost:5173
