{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.ts-dist",
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@ui/*": ["./src/ui/components/*", "./src/ui/components/*.tsx"],
      "@ui/context/*": ["./src/ui/context/*", "./src/ui/context/*.tsx"],
      "@ui/context": ["./src/ui/context/index.ts"],
      "@ui/hooks": ["./src/ui/hooks/index.ts"],
      "@ui/theme/*": ["./src/ui/theme/*"],
      "@ui/theme": ["./src/ui/theme/index.ts"],
      "@ui/theme/context": ["./src/ui/theme/context.tsx"],
      "@ui/styles/*": ["./src/ui/styles/*"],
      "@ui/styles": ["./src/ui/styles/index.css"],
      "@ui/v2/*": ["./src/ui/v2/components/*", "./src/ui/v2/components/*.tsx"],
      "@ui/v2/styles/*": ["./src/ui/v2/styles/*"],
      "@ui/i18n/*": ["./src/ui/i18n/*"],
      "@ui/icons/provider": ["./src/ui/components/provider-icons/types.ts"],
      "@ui/icons/file-type": ["./src/ui/components/file-icons/types.ts"],
      "@ui/icons/app": ["./src/ui/components/app-icons/types.ts"],
      "@ui/storyboard/scaffold": ["./src/ui/storybook/scaffold.tsx"],
      "@ui/storyboard/fixtures": ["./src/ui/storybook/fixtures.ts"],
      "@ui/fonts/*": ["./src/ui/assets/fonts/*"],
      "@ui/audio/*": ["./src/ui/assets/audio/*"],
      "@session-ui/*": ["./src/session-ui/components/*", "./src/session-ui/components/*.tsx"],
      "@session-ui/context": ["./src/session-ui/context/index.ts"],
      "@session-ui/context/*": ["./src/session-ui/context/*", "./src/session-ui/context/*.tsx"],
      "@session-ui/pierre": ["./src/session-ui/pierre/index.ts"],
      "@session-ui/pierre/*": ["./src/session-ui/pierre/*"],
      "@session-ui/styles": ["./src/session-ui/styles/index.css"],
      "@session-ui/v2/*": ["./src/session-ui/v2/components/*", "./src/session-ui/v2/components/*.tsx"]
    }
  },
  "include": ["src", "package.json"],
  "exclude": ["dist", "ts-dist"]
}
